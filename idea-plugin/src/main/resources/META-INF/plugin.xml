<idea-plugin>
  <id>dev.zacsweers.metro.idea</id>
  <name>Metro</name>
  <vendor url="https://github.com/ZacSweers/metro">Zac Sweers</vendor>
  <description><![CDATA[
Metro IDE support for Kotlin dependency injection projects.
  ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.java</depends>
  <depends>org.jetbrains.kotlin</depends>

  <extensions defaultExtensionNs="org.jetbrains.kotlin">
    <supportsKotlinPluginMode supportsK2="true"/>
  </extensions>

  <extensions defaultExtensionNs="com.intellij">
    <projectConfigurable
        parentId="tools"
        id="dev.zacsweers.metro.idea.settings"
        displayName="Metro"
        instance="dev.zacsweers.metro.idea.MetroSettingsConfigurable"/>
    <implicitUsageProvider implementation="dev.zacsweers.metro.idea.unused.MetroImplicitUsageProvider"/>
    <findUsagesHandlerFactory
        implementation="dev.zacsweers.metro.idea.usages.MetroFindUsagesHandlerFactory"
        order="first"/>
    <customUsageSearcher implementation="dev.zacsweers.metro.idea.usages.MetroUsageSearcher"/>
    <usageTypeProvider
        implementation="dev.zacsweers.metro.idea.usages.MetroUsageTypeProvider"
        order="first"/>
    <errorHandler implementation="dev.zacsweers.metro.idea.MetroErrorHandler"/>
    <localInspection
        language="kotlin"
        shortName="MetroGraph"
        displayName="Metro graph validation errors"
        groupName="Metro"
        enabledByDefault="true"
        level="ERROR"
        implementationClass="dev.zacsweers.metro.idea.diagnostics.MetroGraphInspection"/>
    <localInspection
        language="kotlin"
        shortName="MetroGraphWarning"
        displayName="Metro graph validation warnings"
        groupName="Metro"
        enabledByDefault="true"
        level="WARNING"
        implementationClass="dev.zacsweers.metro.idea.diagnostics.MetroGraphWarningInspection"/>
    <intentionAction>
      <className>dev.zacsweers.metro.idea.intentions.injection.MakeClassInjectableIntention</className>
      <category>Metro</category>
    </intentionAction>
    <localInspection
        language="kotlin"
        shortName="MetroContributeBinding"
        displayName="Class can contribute a Metro binding"
        groupName="Metro"
        enabledByDefault="true"
        level="INFORMATION"
        implementationClass="dev.zacsweers.metro.idea.intentions.contributions.MetroContributeBindingInspection"/>
    <codeInsight.lineMarkerProvider
        language="kotlin"
        implementationClass="dev.zacsweers.metro.idea.index.MetroLineMarkerProvider"/>
    <codeInsight.daemonBoundCodeVisionProvider
        implementation="dev.zacsweers.metro.idea.index.MetroCodeVisionProvider"/>
    <config.codeVisionGroupSettingProvider
        implementation="dev.zacsweers.metro.idea.index.MetroCodeVisionGroupSettingProvider"/>
    <codeInsight.declarativeInlayProvider
        language="kotlin"
        implementationClass="dev.zacsweers.metro.idea.index.MetroInjectedImplementationInlayProvider"
        isEnabledByDefault="true"
        group="OTHER_GROUP"
        providerId="metro.injected.implementation"
        bundle="messages.MetroBundle"
        nameKey="metro.inlay.injected.implementation.name"
        descriptionKey="metro.inlay.injected.implementation.description"/>
    <lang.inspectionSuppressor
        language="kotlin"
        implementationClass="dev.zacsweers.metro.idea.unused.MetroUnusedDeclarationInspectionSuppressor"
        order="first"/>
    <lang.inspectionSuppressor
        language="JAVA"
        implementationClass="dev.zacsweers.metro.idea.unused.MetroUnusedDeclarationInspectionSuppressor"
        order="first"/>
    <lang.inspectionSuppressor
        language="kotlin"
        implementationClass="dev.zacsweers.metro.idea.MetroKaptCompilerPluginInspectionSuppressor"
        order="first"/>
    <toolWindow
        id="Metro"
        anchor="right"
        icon="dev.zacsweers.metro.idea.MetroIcons.METRO"
        factoryClass="dev.zacsweers.metro.idea.toolwindow.MetroToolWindowFactory"/>
  </extensions>

  <actions>
    <action
        id="Metro.GoToBinding"
        class="dev.zacsweers.metro.idea.navigation.GoToMetroBindingAction"
        text="Go to Metro Binding"
        description="Opens the binding supplying the Metro dependency at the caret"
        icon="dev.zacsweers.metro.idea.MetroIcons.PROVIDER">
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
    </action>
    <action
        id="Metro.SelectInToolWindow"
        class="dev.zacsweers.metro.idea.navigation.SelectInMetroAction"
        text="Select in Metro"
        description="Reveals the graph or binding at the caret in the Metro tool window"
        icon="dev.zacsweers.metro.idea.MetroIcons.GRAPH">
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
    </action>
    <action
        id="Metro.ExplainBinding"
        class="dev.zacsweers.metro.idea.explanation.ExplainMetroBindingAction"
        text="Why this Metro binding?"
        description="Explains binding selection for the Metro dependency at the caret"
        icon="dev.zacsweers.metro.idea.MetroIcons.PROVIDER">
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
    </action>
    <action
        id="Metro.ValidateGraph"
        class="dev.zacsweers.metro.idea.toolwindow.ValidateMetroGraphAction"
        text="Validate Metro Graph"
        description="Validates the Metro graph at the caret in the Metro tool window"
        icon="dev.zacsweers.metro.idea.MetroIcons.GRAPH">
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
